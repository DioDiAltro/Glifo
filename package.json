    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.1.1",
    "playwright-core": "~1.56.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.2"
  }
