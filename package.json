{
  "name": "glifo",
  "private": true,
  "version": "0.1.0",
  "description": "Appunti universitari in Markdown per ogni materia, con anteprima e suggerimenti dei simboli LaTeX",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node scripts/smoke-test.mjs && node scripts/account-test.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.129.0",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@farscrl/hunspell-wasm": "^1.0.1",
    "@lezer/common": "^1.5.3",
    "@lezer/highlight": "^1.2.5",
    "@lezer/markdown": "^1.7.2",
    "@maxgraph/core": "^0.24.0",
    "@supabase/supabase-js": "^2.117.2",
    "dictionary-en": "^4.0.0",
    "dictionary-it": "^2.0.0",
    "dompurify": "^3.4.16",
    "fflate": "^0.8.3",
    "highlight.js": "^11.12.0",
    "katex": "^0.16.47",
    "markdown-it": "^15.0.2",
    "markdown-it-footnote": "^4.0.0",
    "perfect-freehand": "^1.2.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
